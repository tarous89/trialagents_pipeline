+// Pipeline shares this service. Its optional mail process recovers independently.
+if(process.env.PIPELINE_ENABLED==='true'){
+  function startPipelineMail(){
+    if(stopping)return;
+    const worker=spawn(process.execPath,['scripts/pipeline-worker.mjs'],{stdio:'inherit',env:process.env});
+    children.add(worker);
+    worker.once('error',()=>console.error('pipeline_mail_spawn_failed'));
+    worker.once('close',()=>{children.delete(worker);if(!stopping)setTimeout(startPipelineMail,15000).unref();});
+  }
+  startPipelineMail();
+}
